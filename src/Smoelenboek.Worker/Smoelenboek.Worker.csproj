  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>3f8a2b1c-4d5e-6f7a-8b9c-0d1e2f3a4b5c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smoelenboek.Adapter\Smoelenboek.Adapter.csproj" />
