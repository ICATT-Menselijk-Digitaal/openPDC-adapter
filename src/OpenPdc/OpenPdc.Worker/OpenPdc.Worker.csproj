    <UserSecretsId>c3b2a1f0-d4e5-4678-9abc-def012345678</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
